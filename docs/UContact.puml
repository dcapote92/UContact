@startuml

class Client{
    - id: UUID
    - name: String
}

class Organization{
    - id: UUID
    - name: String
}

class Contact{
    - id: UUID
    - name: String
    - email: String
    - phone: String?
}

Client "1" *-- "0..*" Organization
Organization "1" *-- "0..*" Contact

note on link
    Uma organização só pode ser excluída
    quando não posuir contatos associados.
    Os contatos deve ser excluidos
    ou transferidos previamente.
end note



@enduml